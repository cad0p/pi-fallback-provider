{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  // pi (@earendil-works/pi-*) is a DEV-only dependency: it provides the types
  // index.ts is written against and is resolved by pi's extension loader at
  // runtime, so it never ships. Every source file is typechecked.
  "include": ["index.ts", "aliases.ts", "boundary.ts", "*.test.ts", "vitest.config.mts"]
}
